# AutFin Environment Variables Template
# Copy this file to .env and fill in your API keys

# ===== REQUIRED API KEYS =====

# NVIDIA NIM (primary + fast LLM — free tier)
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# Marketaux (news sentiment — free tier, no credit card)
MARKETAUX_API_KEY=your_marketaux_api_key_here

# FRED (macro data — free tier, no credit card)
FRED_API_KEY=your_fred_api_key_here

# ===== BROWSER MCP (Obscura — REQUIRED for JS-rendered sites) =====
# Hard runtime dependency. Obscura is a Rust binary (Apache-2.0, ~30 MB RAM,
# 70 MB binary) that exposes a Model Context Protocol server.
# Download: https://github.com/h4ckf0r0day/obscura/releases/latest
#   Windows: obscura-x86_64-windows.zip — extract, add folder to PATH
#   Linux:   obscura-x86_64-linux.tar.gz
#   macOS:   obscura-aarch64-macos.zip
#
# TRANSPORT = streamable_http (default, recommended)
#   AutFin runs `obscura mcp --http --port 8080` as a long-lived subprocess
#   (see BrowserMCPLifecycle). Multiple LangGraph worker threads then share
#   one Obscura instance over HTTP — independent of Python subprocess
#   lifecycle, restart-safe across `langgraph dev` reloads, and observable
#   in OS process tooling (`netstat`, task manager).
#
# If you prefer stdio per-graph-run, set BROWSER_MCP_TRANSPORT=stdio.
#
# Without Obscura on PATH, the BrowserMCPClient raises on first call with
# the exact install command.
BROWSER_MCP_TRANSPORT=streamable_http
BROWSER_MCP_HOST=127.0.0.1
BROWSER_MCP_PORT=9333
BROWSER_MCP_ENDPOINT=http://127.0.0.1:9333/mcp
# Autostart = 'true' (default): AutFin launches `obscura mcp --http`
# as a background subprocess if port 8080 is not already serving an MCP
# endpoint. Set to 'false' if you manage obscura yourself
# (e.g. systemd / Docker / OCI sidecar).
BROWSER_MCP_AUTOSTART=true
# Path to obscura binary (optional override; otherwise AutFin searches PATH)
# BROWSER_MCP_BINARY=/usr/local/bin/obscura

# ===== ZERODHA KITE (Personal Tier — free) =====

# Kite API credentials (from https://developers.kite.trade)
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# Programmatic login credentials (for automated daily login)
KITE_USER_ID=your_zerodha_user_id_here
KITE_PASSWORD=your_zerodha_password_here
# TOTP secret from Zerodha console - 2FA settings - external authenticator
KITE_TOTP_SECRET=your_totp_secret_here

# ----- (Firecrawl removed — v5.6 browser MCP replaces it) -----

# ===== OPTIONAL: Social Sentiment =====

# Reddit (PRAW — fast JSON path when creds exist; else browser MCP fallback)
# Register app at https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret
# REDDIT_USER_AGENT=AutFin-SentimentAgent/1.0

# ===== LLM FALLBACK KEYS (optional) =====

# OpenRouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# Groq
# GROQ_API_KEY=your_groq_api_key_here
# Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# Cerebras
# CEREBRAS_API_KEY=your_cerebras_api_key_here

# === OBSERVABILITY ===

# Logfire (default; see .env values)
# LOGFIRE_TOKEN=your_logfire_token
# LANGCHAIN_TRACING_V2=false  # Disabled in v7.0 — Logfire used instead

# ===== OPTIONAL: Notifications =====

# Pushover
# PUSHOVER_USER_KEY=your_pushover_user_key
# PUSHOVER_API_TOKEN=your_pushover_api_token

# SMTP (email alerts)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=your_email@gmail.com
# SMTP_TO=recipient@email.com
